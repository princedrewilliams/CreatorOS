{
  "headers": {
    "x-nextjs-stale-time": "30",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/profile/layout,_N_T_/profile/page,_N_T_/profile"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/profile/__PAGE__",
    "/profile",
    "/_index",
    "/_head"
  ]
}